# Backend API Base URL (e.g. Render backend service URL)
# In development, leave empty or default to '/api/v1' (uses Vite proxy)
VITE_API_BASE_URL=https://resolvegent-api.onrender.com/api/v1

# Alert Engine URL (e.g. Render alert engine service URL)
VITE_ALERT_ENGINE_URL=https://ecommerce-alerts.onrender.com

# Optional: Storefront URL
VITE_STOREFRONT_URL=https://ecommerce-store.vercel.app
