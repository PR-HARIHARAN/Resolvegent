FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy project specification & readme required for build
COPY pyproject.toml README.md ./

# Install python dependencies via uv
RUN uv pip install --system -r pyproject.toml

# Copy application source code
COPY src/ ./src/
COPY prompts/ ./prompts/

# Ensure data directory exists
RUN mkdir -p /app/data

# Install the local incident-engine package into python environment
RUN uv pip install --system -e .

# Pre-download Hugging Face embedding model so container starts instantly
RUN python -c "from langchain_huggingface import HuggingFaceEmbeddings; HuggingFaceEmbeddings(model_name='BAAI/bge-small-en-v1.5')"

EXPOSE 8000

CMD ["uvicorn", "incident_engine.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
